<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="JHandsFree.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:applicationModel="clr-namespace:Microsoft.Maui.ApplicationModel;assembly=Microsoft.Maui.Essentials">

    <VerticalStackLayout
        Padding="30,0"
        Spacing="12"
        VerticalOptions="Center">
        <Label
            Style="{StaticResource Headline}"
            Text="J-HandsFree"
            SemanticProperties.HeadingLevel="Level1" />
        <Label
            x:DataType="applicationModel:IAppInfo"
            Style="{StaticResource SubHeadline}"
            Text="{Binding VersionString, Source={x:Static applicationModel:AppInfo.Current}, StringFormat='Version {0}'}" />
    </VerticalStackLayout>

</ContentPage>
