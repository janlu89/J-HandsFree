<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JHandsFree.Spike.MainPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,Auto,Auto,Auto"
              ColumnSpacing="4"
              Padding="6">
            <Label x:Name="StatusLabel"
                   VerticalOptions="Center"
                   FontSize="11" />
            <Button Grid.Column="1"
                    Text="UA"
                    Clicked="OnNextUserAgentClicked" />
            <Button Grid.Column="2"
                    Text="Shield"
                    Clicked="OnShieldClicked" />
            <Button Grid.Column="3"
                    Text="Native"
                    Clicked="OnNativeClicked" />
            <Button Grid.Column="4"
                    Text="Clear"
                    Clicked="OnClearDataClicked" />
        </Grid>

        <Label x:Name="AddressLabel"
               Grid.Row="1"
               Padding="8,0,8,4"
               FontSize="12"
               LineBreakMode="TailTruncation" />

        <WebView x:Name="Browser"
                 Grid.Row="2"
                 HandlerChanged="OnBrowserHandlerChanged"
                 Navigating="OnBrowserNavigating"
                 Navigated="OnBrowserNavigated" />

    </Grid>

</ContentPage>
