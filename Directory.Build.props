<Project>

  <PropertyGroup Label="Language">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Quality gates">
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
    <!-- The compiler reports unnecessary usings (IDE0005) on build only when it generates the XML documentation file.
         Missing XML comments (CS1591) stay allowed: comments are written only where a name is not enough. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Label="Product">
    <Product>J-HandsFree</Product>
    <Authors>Gianluca Meola</Authors>
    <Company>Gianluca Meola</Company>
    <Copyright>Copyright (c) 2026 Gianluca Meola</Copyright>
    <RepositoryUrl>https://github.com/janlu89/J-HandsFree</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
